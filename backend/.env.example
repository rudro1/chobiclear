# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
RESULT_DIR=results
FILE_EXPIRY_MINUTES=60

# ─── Rate Limiting ────────────────────────────────────────────────────────────
FREE_RATE_LIMIT_PER_DAY=10

# ─── SSLCommerz ───────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_SANDBOX=True
SSLCOMMERZ_SUCCESS_URL=https://your-frontend.vercel.app/payment/success
SSLCOMMERZ_FAIL_URL=https://your-frontend.vercel.app/payment/fail
SSLCOMMERZ_CANCEL_URL=https://your-frontend.vercel.app/payment/cancel
SSLCOMMERZ_IPN_URL=https://your-backend.railway.app/payment/ipn

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
